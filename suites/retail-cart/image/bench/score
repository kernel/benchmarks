#!/usr/bin/env python3
"""Turn the agent's finalize report into the task's rewards.

`reward` is 1 when the agent reported success, and 0 for any other outcome or
when it never called finalize. `finalized` records whether it called
finalize, and `outcome_<name>` which failure it reported, so bot blocks can be
told apart from other website errors, Kernel errors and the agent's own
failures.

The browser's final URL and title are saved next to the report, so a reported
success can be checked against the page the agent ended on.
"""

from __future__ import annotations

import json
import os
import shutil
import urllib.request
from pathlib import Path

REPORT = Path("/logs/agent/finalize.json")
TASK = Path("/opt/bench/task.json")
VERIFIER = Path("/logs/verifier")
FAILURES = ("failed", "blocked", "website_error", "kernel_error")

FINAL_PAGE = "return { url: page.url(), title: await page.title() };"


def final_page() -> dict:
    base = (os.environ.get("KERNEL_BASE_URL") or "https://api.onkernel.com").rstrip("/")
    request = urllib.request.Request(
        f"{base}/browsers/{os.environ['KERNEL_SESSION_ID']}/playwright/execute",
        data=json.dumps({"code": FINAL_PAGE, "timeout_sec": 30}).encode(),
        headers={
            "Authorization": f"Bearer {os.environ['KERNEL_API_KEY']}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            result = json.load(response)
    except (OSError, ValueError, KeyError) as error:
        return {"error": str(error)}
    if not result.get("success"):
        return {"error": result.get("error")}
    return result.get("result") or {}


def main() -> int:
    VERIFIER.mkdir(parents=True, exist_ok=True)
    try:
        report = json.loads(REPORT.read_text())
    except (OSError, json.JSONDecodeError):
        report = None
    if report is not None:
        shutil.copy2(REPORT, VERIFIER / "finalize.json")
    if TASK.exists():
        shutil.copy2(TASK, VERIFIER / "task.json")
    (VERIFIER / "final-page.json").write_text(json.dumps(final_page(), indent=2))
    outcome = report.get("outcome") if report is not None else None
    rewards = {
        "reward": float(outcome == "success"),
        "finalized": float(report is not None),
        **{f"outcome_{name}": float(outcome == name) for name in FAILURES},
    }
    (VERIFIER / "reward.json").write_text(json.dumps(rewards, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
