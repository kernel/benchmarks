#!/usr/bin/env python3
"""Turn the agent's finalize report into the task's rewards, and check the cart.

`reward` is 1 when the agent reported success, and 0 for any other outcome or
when it never called finalize. `finalized` records whether it called
finalize, and `outcome_<name>` which failure it reported, so bot blocks can be
told apart from other website errors, Kernel errors and the agent's own
failures.

The browser is the Kernel VM's, reached through Kernel's API, or a remote
browser reached over CDP when the environment wrote its URL. The browser's
final URL and title are saved, then the verifier checks the
cart itself: it reads the page the agent ended on when that is already the
cart, otherwise opens the task's `cart_url`, or fetches its `cart_api` from
the page, and sets `cart_verified` when the text matches `cart_match`. When
the check could not see the cart, because loading it failed or showed a bot
check, it sets `cart_unverifiable` instead, so a failed check is not counted
as an empty cart. cart-check.json keeps what it saw.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import urllib.parse
import urllib.request
from pathlib import Path

REPORT = Path("/logs/agent/finalize.json")
TASK = Path("/opt/bench/task.json")
# Written by the remote-browser environment; absent in a Kernel browser's VM.
CDP_URL_FILE = Path("/run/browser/cdp-url")
VERIFIER = Path("/logs/verifier")
FAILURES = ("failed", "blocked", "website_error", "kernel_error")

FINAL_PAGE = "return { url: page.url(), title: await page.title() };"

# A bot check or access-denied page in place of the cart.
CHALLENGE = re.compile(
    r"captcha|/checkpoint/|validateCaptcha|verify (yourself|access|you are)|access denied"
    r"|access is temporarily restricted|press (and|&) hold|are you a robot",
    re.IGNORECASE,
)

CURRENT_PAGE = """
return {
  url: page.url(),
  title: await page.title(),
  text: await page.evaluate(() => (document.body ? document.body.innerText : "")),
};
"""

CART_PAGE = """
const response = await page.goto(%s, { waitUntil: "domcontentloaded", timeout: 45000 });
await page.waitForLoadState("networkidle", { timeout: 15000 }).catch(() => {});
await page.waitForTimeout(3000);
return {
  url: page.url(),
  status: response ? response.status() : null,
  title: await page.title(),
  text: await page.evaluate(() => (document.body ? document.body.innerText : "")),
};
"""

CART_API = """
return await page.evaluate(async (url) => {
  const response = await fetch(url, { headers: { Accept: "application/json" }, credentials: "include" });
  return { url, status: response.status, text: await response.text() };
}, %s);
"""


def execute(code: str, timeout_sec: int) -> dict:
    if CDP_URL_FILE.exists():
        return execute_over_cdp(code, timeout_sec)
    base = (os.environ.get("KERNEL_BASE_URL") or "https://api.onkernel.com").rstrip("/")
    request = urllib.request.Request(
        f"{base}/browsers/{os.environ['KERNEL_SESSION_ID']}/playwright/execute",
        data=json.dumps({"code": code, "timeout_sec": timeout_sec}).encode(),
        headers={
            "Authorization": f"Bearer {os.environ['KERNEL_API_KEY']}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout_sec + 30) as response:
            result = json.load(response)
    except (OSError, ValueError, KeyError) as error:
        return {"error": str(error)}
    if not result.get("success"):
        return {"error": result.get("error")}
    return result.get("result") or {}


def execute_over_cdp(code: str, timeout_sec: int) -> dict:
    try:
        output = subprocess.run(
            ["/opt/bench/cdp-execute", str(timeout_sec)],
            input=code,
            capture_output=True,
            text=True,
            timeout=timeout_sec + 30,
        )
        result = json.loads(output.stdout)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        return {"error": str(error)}
    if not result.get("success"):
        return {"error": result.get("error")}
    return result.get("result") or {}


def same_page(url: str, other: str) -> bool:
    a, b = urllib.parse.urlsplit(url), urllib.parse.urlsplit(other)
    return (a.netloc, a.path.rstrip("/").lower()) == (b.netloc, b.path.rstrip("/").lower())


def check_cart(task: dict, final_page: dict) -> dict:
    if task.get("cart_api"):
        seen = execute(CART_API % json.dumps(task["cart_api"]), 60)
    elif task.get("cart_url"):
        if same_page(final_page.get("url") or "", task["cart_url"]):
            seen = execute(CURRENT_PAGE, 60)
        else:
            seen = execute(CART_PAGE % json.dumps(task["cart_url"]), 90)
    else:
        return {"verified": False, "unverifiable": True, "error": "task has no cart_url or cart_api"}
    text = seen.pop("text", None) or ""
    match = re.search(task["cart_match"], text, re.IGNORECASE) if task.get("cart_match") else None
    seen["verified"] = match is not None
    challenge = CHALLENGE.search(f"{seen.get('url', '')} {seen.get('title', '')} {text[:3000]}")
    seen["unverifiable"] = match is None and ("error" in seen or challenge is not None)
    if challenge and match is None:
        seen["challenge"] = challenge.group(0)
    if match:
        seen["excerpt"] = text[max(0, match.start() - 200) : match.end() + 200]
    else:
        seen["excerpt"] = text[:2000]
    return seen


def main() -> int:
    VERIFIER.mkdir(parents=True, exist_ok=True)
    try:
        report = json.loads(REPORT.read_text())
    except (OSError, json.JSONDecodeError):
        report = None
    if report is not None:
        shutil.copy2(REPORT, VERIFIER / "finalize.json")
    task = json.loads(TASK.read_text()) if TASK.exists() else {}
    if task:
        shutil.copy2(TASK, VERIFIER / "task.json")
    final_page = execute(FINAL_PAGE, 30)
    (VERIFIER / "final-page.json").write_text(json.dumps(final_page, indent=2))
    cart = check_cart(task, final_page)
    (VERIFIER / "cart-check.json").write_text(json.dumps(cart, indent=2))
    outcome = report.get("outcome") if report is not None else None
    rewards = {
        "reward": float(outcome == "success"),
        "finalized": float(report is not None),
        "cart_verified": float(cart.get("verified") is True),
        "cart_unverifiable": float(cart.get("unverifiable") is True),
        **{f"outcome_{name}": float(outcome == name) for name in FAILURES},
    }
    (VERIFIER / "reward.json").write_text(json.dumps(rewards, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
