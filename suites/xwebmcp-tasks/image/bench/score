#!/usr/bin/env python3
"""Turn the agent's finalize report into the task's rewards.

`reward` is 1 when the agent reported success, and 0 when it reported failure
or never called finalize. `finalized` records whether it called finalize.
"""

from __future__ import annotations

import json
import shutil
from pathlib import Path

REPORT = Path("/logs/agent/finalize.json")
VERIFIER = Path("/logs/verifier")


def main() -> int:
    VERIFIER.mkdir(parents=True, exist_ok=True)
    try:
        report = json.loads(REPORT.read_text())
    except (OSError, json.JSONDecodeError):
        report = None
    if report is not None:
        shutil.copy2(REPORT, VERIFIER / "finalize.json")
    rewards = {
        "reward": float(report is not None and report.get("success") is True),
        "finalized": float(report is not None),
    }
    (VERIFIER / "reward.json").write_text(json.dumps(rewards, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
