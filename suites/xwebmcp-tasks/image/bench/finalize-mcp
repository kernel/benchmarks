#!/usr/bin/env python3
"""stdio MCP server with one tool, `finalize`, the agent's report of the task.

The first call writes the report to /logs/agent/finalize.json, where the
verifier reads it; later calls are refused, so the first report stands.
`evidence` and `reasoning` come before `outcome` in the schema so the agent
writes down what it saw and checks it before it gives a verdict.

`outcome` separates the agent's own failures from failures it could not
control: the website's (third party) and Kernel's (first party).
"""

from __future__ import annotations

import json
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

REPORT = Path("/logs/agent/finalize.json")

OUTCOMES = {
    "success": "every requirement of the task is met and the evidence shows it.",
    "failed": (
        "the task is not done, including when what the task asks for does not exist or is "
        "unavailable on the site."
    ),
    "website_error": (
        "the website kept you from finishing: it showed an error, failed to load, or blocked "
        "you, for example with a bot check or an access-denied page."
    ),
    "kernel_error": (
        "the Kernel browser or its tools kept you from finishing: the browser REPL, a WebMCP "
        "tool or the browser itself errored, hung, or crashed."
    ),
}

TOOL = {
    "name": "finalize",
    "description": (
        "Report the outcome of the task. Call this exactly once, when the task is done or you "
        "are certain it cannot be done, and stop afterwards. Your report is the result of the "
        "task."
    ),
    "inputSchema": {
        "type": "object",
        "properties": {
            "evidence": {
                "type": "string",
                "description": (
                    "What you observed in the browser that shows whether the task is done: the "
                    "values, text and URLs the task asks for, quoted as the page shows them, "
                    "including everything the task asks you to report."
                ),
            },
            "reasoning": {
                "type": "string",
                "description": (
                    "Check the evidence against each requirement of the task in turn and say "
                    "whether it is met. Name anything you could not verify."
                ),
            },
            "outcome": {
                "type": "string",
                "enum": list(OUTCOMES),
                "description": "How the task ended. "
                + " ".join(f"{name}: {meaning}" for name, meaning in OUTCOMES.items()),
            },
        },
        "required": ["evidence", "reasoning", "outcome"],
        "additionalProperties": False,
    },
    "annotations": {"readOnlyHint": False, "idempotentHint": False},
}


def finalize(arguments: dict[str, Any]) -> tuple[str, bool]:
    if REPORT.exists():
        return "The task was already finalized. Stop now.", True
    evidence, reasoning, outcome = (
        arguments.get(key) for key in ("evidence", "reasoning", "outcome")
    )
    if not isinstance(evidence, str) or not evidence.strip():
        return "evidence must be a non-empty string.", True
    if not isinstance(reasoning, str) or not reasoning.strip():
        return "reasoning must be a non-empty string.", True
    if outcome not in OUTCOMES:
        return f"outcome must be one of {', '.join(OUTCOMES)}.", True
    REPORT.parent.mkdir(parents=True, exist_ok=True)
    report = {
        "outcome": outcome,
        "evidence": evidence,
        "reasoning": reasoning,
        "finalized_at": datetime.now(UTC).isoformat(),
    }
    REPORT.write_text(json.dumps(report, indent=2))
    return "Recorded. The task is finalized; stop now.", False


def handle(message: dict[str, Any]) -> dict[str, Any] | None:
    method = message.get("method")
    if "id" not in message:
        return None
    if method == "initialize":
        params = message.get("params") or {}
        result: dict[str, Any] = {
            "protocolVersion": params.get("protocolVersion", "2025-06-18"),
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "bench", "version": "1.0.0"},
        }
    elif method == "ping":
        result = {}
    elif method == "tools/list":
        result = {"tools": [TOOL]}
    elif method == "tools/call":
        params = message.get("params") or {}
        if params.get("name") != TOOL["name"]:
            text, is_error = f"Unknown tool {params.get('name')!r}.", True
        else:
            text, is_error = finalize(params.get("arguments") or {})
        result = {"content": [{"type": "text", "text": text}], "isError": is_error}
    else:
        return {
            "jsonrpc": "2.0",
            "id": message["id"],
            "error": {"code": -32601, "message": f"Method not found: {method}"},
        }
    return {"jsonrpc": "2.0", "id": message["id"], "result": result}


def main() -> int:
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            response: dict[str, Any] | None = {
                "jsonrpc": "2.0",
                "id": None,
                "error": {"code": -32700, "message": "Parse error"},
            }
        else:
            response = handle(message) if isinstance(message, dict) else None
        if response is not None:
            sys.stdout.write(json.dumps(response) + "\n")
            sys.stdout.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
