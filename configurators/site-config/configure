#!/usr/bin/env python3
"""Choose browser settings from Kernel's config registry.

1. An LLM reads the task config and instruction and names the one primary
   website the task runs on, if there is one.
2. Kernel's config registry looks that site up and returns a recommended
   browser and proxy recipe, plus guidance for navigating the site.
3. An LLM translates the proxy recipe into a Kernel proxy, which is created
   once per distinct recipe and then reused by name.
4. The guidance becomes steering for the agent when `steering` is enabled.

stdin:  {"task": {"config": str, "instruction": str}, "args": {"model": str, "steering": bool}}
stdout: {"browser": {...}, "steering": str | null, "provenance": {...}}
"""

from __future__ import annotations

import hashlib
import json
import re
import sys
from typing import Any

import litellm
from kernel import Kernel

DEFAULT_MODEL = "anthropic/claude-haiku-5-5"

SITE_PROMPT = """You are preparing a browser for an agent that will perform the task below.
Identify the one primary website the task is performed on: the site where the agent
spends most of its time and completes the task. If the task names several sites, pick
the one where the final action happens. If the task does not involve a specific website,
answer null.

Respond with only JSON: {{"url": "https://..."}} using a public http(s) URL for that
site (its homepage is fine), or {{"url": null}}.

Task config (TOML):
{config}

Task instruction:
{instruction}
"""

PROXY_PROMPT = """Kernel's config registry recommends this proxy recipe for a website:

{recipe}

Translate it into Kernel browser proxy settings. Respond with only JSON, one of:
- {{"mode": "direct"}} for no proxy
- {{"mode": "default"}} for the browser's default egress
- {{"create": <request body for POST /proxies>}} when a proxy must be created.

The POST /proxies body has: "type" (one of "isp", "residential", "mobile"), optional
"config" (for isp: "country"; for residential: "country", "state", "city", "zip", "asn",
"os"; for mobile: "country", "state", "city"), optional "bypass_hosts" (list of
hostnames), and optional "protocol" ("http" or "https"). Do not include "name".
"""


def ask(model: str, prompt: str) -> dict[str, Any]:
    response = litellm.completion(
        model=model,
        messages=[{"role": "user", "content": prompt}],
        num_retries=3,
    )
    text = response.choices[0].message.content or ""
    match = re.search(r"\{.*\}", text, re.DOTALL)
    if not match:
        raise ValueError(f"model did not return JSON: {text[:200]}")
    return json.loads(match.group(0))


def proxy_settings(client: Kernel, model: str, recipe: dict[str, Any]) -> dict[str, Any]:
    proxy = ask(model, PROXY_PROMPT.format(recipe=json.dumps(recipe, indent=2)))
    if "create" not in proxy:
        return {"mode": proxy["mode"]}
    body = proxy["create"]
    digest = hashlib.sha256(json.dumps(body, sort_keys=True).encode()).hexdigest()[:12]
    name = f"site-config-{body['type']}-{digest}"
    for existing in client.proxies.list():
        if existing.name == name:
            return {"name": name}
    try:
        client.proxies.create(**body, name=name)
    except Exception:
        # Another task may have created the same proxy concurrently.
        if not any(existing.name == name for existing in client.proxies.list()):
            raise
    return {"name": name}


def main() -> int:
    request = json.load(sys.stdin)
    task = request["task"]
    args = request.get("args") or {}
    model = args.get("model", DEFAULT_MODEL)

    site = ask(model, SITE_PROMPT.format(**task)).get("url")
    output: dict[str, Any] = {"browser": {}, "steering": None, "provenance": {"url": site}}
    if not site:
        json.dump(output, sys.stdout)
        return 0

    client = Kernel()
    lookup = client.config_registry.lookup(url=site).model_dump(mode="json", exclude_none=True)
    recommendation = lookup.get("recommendation") or {}
    output["provenance"].update(
        {
            "matched_target": recommendation.get("matched_target"),
            "match_scope": recommendation.get("match_scope"),
            "evidence": recommendation.get("evidence"),
            "proxy_recipe": recommendation.get("proxy"),
        }
    )
    if recommendation.get("type") == "recommendation":
        output["browser"] = dict(recommendation["browser"])
        output["browser"]["proxy"] = proxy_settings(client, model, recommendation["proxy"])
    if args.get("steering", True):
        output["steering"] = lookup.get("guidance")
    json.dump(output, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
