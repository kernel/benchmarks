#!/usr/bin/env python3
"""Add `xwebmcp_registered` to the task's rewards and keep the registration record.

`xwebmcp_registered` is 1 when xwebmcp-register registered at least one tool
before the agent started, so a treatment trial without its tools can be told
apart from one whose agent did not use them (kernel-mcp-verify's
`webmcp_invoked`).
"""

from __future__ import annotations

import json
from pathlib import Path

REGISTRATION = Path("/run/xwebmcp/registration.json")
VERIFIER = Path("/logs/verifier")


def main() -> int:
    VERIFIER.mkdir(parents=True, exist_ok=True)
    try:
        registration = json.loads(REGISTRATION.read_text())
    except (OSError, json.JSONDecodeError):
        registration = {}
    (VERIFIER / "xwebmcp-registration.json").write_text(json.dumps(registration, indent=2))

    reward_path = VERIFIER / "reward.json"
    if reward_path.exists():
        rewards = json.loads(reward_path.read_text())
        rewards["xwebmcp_registered"] = float(bool(registration.get("registered")))
        reward_path.write_text(json.dumps(rewards, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
