#!/usr/bin/env python3
"""Add `kernel_mcp_valid` to the task's rewards.

The suite's verifier owns the task reward. This check records whether the
agent actually used Kernel MCP, and only with the browser Harbor assigned to
the trial, so a failed task can be told apart from a trial that never
exercised the toolset.
"""

from __future__ import annotations

import json
import os
import shutil
from pathlib import Path
from typing import Any

LOGS = Path("/logs")
VERIFIER = LOGS / "verifier"
PLAYWRIGHT_TOOLS = {
    "execute_playwright_code",
    "kernel__execute_playwright_code",
    "mcp__kernel__execute_playwright_code",
}


def read_object(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def main() -> int:
    VERIFIER.mkdir(parents=True, exist_ok=True)
    shutil.copytree("/var/log/kernel-mcp", VERIFIER / "kernel-mcp", dirs_exist_ok=True)

    trajectory = read_object(LOGS / "agent" / "trajectory.json")
    calls = [
        call
        for step in trajectory.get("steps") or []
        for call in step.get("tool_calls") or []
        if call.get("function_name") in PLAYWRIGHT_TOOLS
    ]
    called_sessions = {(call.get("arguments") or {}).get("session_id") for call in calls}
    expected_session = os.environ.get("KERNEL_SESSION_ID")
    checks = {
        "used_kernel_mcp": bool(calls),
        "used_assigned_browser": bool(expected_session) and called_sessions == {expected_session},
    }
    valid = all(checks.values())

    sha_file = Path("/opt/kernel-mcp-server/SOURCE_SHA")
    result = {
        "valid": valid,
        "checks": checks,
        "expected_session_id": expected_session,
        "called_session_ids": sorted(str(value) for value in called_sessions),
        "kernel_mcp_server_sha": sha_file.read_text().strip() if sha_file.exists() else None,
    }
    (VERIFIER / "kernel-mcp-result.json").write_text(json.dumps(result, indent=2))

    # Only extend structured rewards; adding reward.json next to a suite's
    # reward.txt would hide the task reward.
    reward_path = VERIFIER / "reward.json"
    if reward_path.exists():
        rewards = read_object(reward_path)
        rewards["kernel_mcp_valid"] = float(valid)
        reward_path.write_text(json.dumps(rewards, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
