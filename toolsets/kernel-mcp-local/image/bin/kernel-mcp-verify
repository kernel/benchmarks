#!/usr/bin/env python3
"""Add `kernel_mcp_valid` and `webmcp_invoked` to the task's rewards.

The suite's verifier owns the task reward. This check records whether the
agent called the Kernel MCP browser tools its arm enables
(`execute_playwright_code`, `browser_repl`), and whether every call used the
browser Harbor assigned to the trial, so a failed task can be told apart from
a trial that never exercised the toolset. It reads the calls mcp-call-log
recorded at the server, which every agent harness goes through, and does not
see browser control outside Kernel MCP, such as direct CDP connections.

`webmcp_invoked` records whether any REPL cell called `webmcp.invokeTool`,
so each arm reports how often the agent used a WebMCP tool, whether the page
provided it or a toolset registered it. kernel-mcp-result.json also counts the
browser calls and their total time.
"""

from __future__ import annotations

import json
import os
import re
import shutil
from pathlib import Path
from typing import Any

LOGS = Path("/var/log/kernel-mcp")
VERIFIER = Path("/logs/verifier")
TOOLS = {"playwright": "execute_playwright_code", "repl": "browser_repl"}
INVOKE = re.compile(r"\binvokeTool\s*\(")


def read_calls(path: Path) -> list[dict[str, Any]]:
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return []
    calls = []
    for line in lines:
        try:
            calls.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return calls


def main() -> int:
    VERIFIER.mkdir(parents=True, exist_ok=True)
    if LOGS.is_dir():
        shutil.copytree(LOGS, VERIFIER / "kernel-mcp", dirs_exist_ok=True)

    enabled = os.environ.get("KERNEL_MCP_ENABLED_TOOLSETS", "playwright").split(",")
    browser_tools = {TOOLS[name] for name in enabled if name in TOOLS}
    calls = [call for call in read_calls(LOGS / "calls.jsonl") if call.get("tool") in browser_tools]
    called_sessions = {(call.get("arguments") or {}).get("session_id") for call in calls}
    expected_session = os.environ.get("KERNEL_SESSION_ID")
    checks = {
        "used_kernel_mcp": bool(calls),
        "used_assigned_browser": bool(expected_session) and called_sessions == {expected_session},
    }
    valid = all(checks.values())
    invocations = sum(
        len(INVOKE.findall(str((call.get("arguments") or {}).get("code") or "")))
        for call in calls
        if call.get("tool") == "browser_repl"
    )

    sha_file = Path("/opt/kernel-mcp-server/SOURCE_SHA")
    result = {
        "valid": valid,
        "checks": checks,
        "enabled_toolsets": enabled,
        "expected_session_id": expected_session,
        "called_session_ids": sorted(str(value) for value in called_sessions),
        "browser_calls": len(calls),
        "browser_call_ms": sum(call.get("duration_ms") or 0 for call in calls),
        "browser_call_errors": sum(1 for call in calls if call.get("is_error")),
        "webmcp_invocations": invocations,
        "kernel_mcp_server_sha": sha_file.read_text().strip() if sha_file.exists() else None,
    }
    (VERIFIER / "kernel-mcp-result.json").write_text(json.dumps(result, indent=2))

    # Only extend structured rewards; adding reward.json next to a suite's
    # reward.txt would hide the task reward.
    reward_path = VERIFIER / "reward.json"
    if reward_path.exists():
        rewards = json.loads(reward_path.read_text())
        rewards["kernel_mcp_valid"] = float(valid)
        if "browser_repl" in browser_tools:
            rewards["webmcp_invoked"] = float(invocations > 0)
        reward_path.write_text(json.dumps(rewards, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
