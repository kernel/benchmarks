#!/usr/bin/env python3
"""Record browser tool usage from the stdio call log, independently of agent transcripts.

Adds `kernel_mcp_valid` to the task's rewards. In the browser-approach arms a
trial that is not valid also gets zero reward. A call the proxy rejected never
reached the browser, so it is counted and not held against the trial.
"""

from __future__ import annotations

import json
import os
import re
import shutil
from pathlib import Path
from typing import Any

LOGS = Path("/var/log/kernel-mcp")
VERIFIER = Path("/logs/verifier")
WEBMCP_IN_CODE = re.compile(r"\bwebmcp\b|\b(?:listTools|invokeTool)\s*\(")
TOOLS = {
    "playwright": "execute_playwright_code",
    "repl": "browser_repl",
    "computer": "computer_action",
    "webmcp": "webmcp",
}


def read_calls(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    calls = []
    for line in path.read_text().splitlines():
        try:
            call = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(call, dict):
            calls.append(call)
    return calls


# The proxy logs arguments as the agent sent them, so they may have any shape.
def arguments(call: dict[str, Any]) -> dict[str, Any]:
    value = call.get("arguments")
    return value if isinstance(value, dict) else {}


def code(call: dict[str, Any]) -> str:
    return str(arguments(call).get("code") or "")


def session_id(call: dict[str, Any]) -> str | None:
    value = arguments(call).get("session_id")
    return value if isinstance(value, str) else None


def check_calls(
    calls: list[dict[str, Any]], enabled: list[str], session: str | None, approach: str | None
) -> dict[str, Any]:
    allowed = {TOOLS[name] for name in enabled if name in TOOLS}
    forwarded = [call for call in calls if not call.get("rejected")]
    browser_calls = [call for call in forwarded if call.get("tool") in allowed]
    sessions = {session_id(call) for call in browser_calls}
    invocations = [
        call.get("webmcp") if isinstance(call.get("webmcp"), dict) else {}
        for call in browser_calls
        if call.get("tool") == "webmcp" and arguments(call).get("action") == "invoke"
    ]
    # An invocation from code names no tool the proxy can see, so it is counted apart.
    from_code = any(re.search(r"\binvokeTool\s*\(", code(call)) for call in browser_calls)
    tools: dict[str, dict[str, Any]] = {}
    for entry in invocations:
        tool = tools.setdefault(
            entry.get("tool") or "unknown",
            {"custom": entry.get("custom"), "invocations": 0, "completed": 0},
        )
        tool["invocations"] += 1
        tool["completed"] += bool(entry.get("ok"))

    def used(custom: bool, completed: bool) -> bool:
        return any(
            entry.get("custom") is custom and (entry.get("ok") or not completed)
            for entry in invocations
        )

    checks = {
        "used_kernel_mcp": bool(browser_calls),
        "used_assigned_browser": bool(session) and sessions == {session},
    }
    if approach:
        checks["allowed_tools_only"] = all(call.get("tool") in allowed for call in forwarded)
    if approach == "playwright":
        checks["no_webmcp"] = not any(WEBMCP_IN_CODE.search(code(call)) for call in browser_calls)
    return {
        "valid": all(checks.values()),
        "checks": checks,
        "enabled_toolsets": enabled,
        "expected_session_id": session,
        "called_session_ids": sorted(str(value) for value in sessions),
        "browser_calls": len(browser_calls),
        "browser_call_ms": sum(call.get("duration_ms") or 0 for call in browser_calls),
        "browser_call_errors": sum(bool(call.get("is_error")) for call in browser_calls),
        "rejected_calls": len(calls) - len(forwarded),
        "call_cap_hit": any(call.get("capped") for call in calls),
        "webmcp_invoked": bool(invocations) or from_code,
        "webmcp_invoked_from_code": from_code,
        "injected_tool_invoked": used(True, False),
        "injected_tool_completed": used(True, True),
        "native_tool_invoked": used(False, False),
        "native_tool_completed": used(False, True),
        "webmcp_tools": tools,
    }


def main() -> int:
    VERIFIER.mkdir(parents=True, exist_ok=True)
    if LOGS.is_dir():
        shutil.copytree(LOGS, VERIFIER / "kernel-mcp", dirs_exist_ok=True)
    approach = os.environ.get("BROWSER_APPROACH")
    result = check_calls(
        read_calls(LOGS / "calls.jsonl"),
        os.environ.get("KERNEL_MCP_ENABLED_TOOLSETS", "playwright").split(","),
        os.environ.get("KERNEL_SESSION_ID"),
        approach,
    )
    sha_file = Path("/opt/kernel-mcp-server/SOURCE_SHA")
    result["kernel_mcp_server_sha"] = sha_file.read_text().strip() if sha_file.exists() else None
    (VERIFIER / "kernel-mcp-result.json").write_text(json.dumps(result, indent=2))
    reward_path = VERIFIER / "reward.json"
    if reward_path.exists():
        rewards = json.loads(reward_path.read_text())
        rewards["kernel_mcp_valid"] = float(result["valid"])
        if approach:
            for name in (
                "webmcp_invoked",
                "webmcp_invoked_from_code",
                "injected_tool_invoked",
                "injected_tool_completed",
                "native_tool_invoked",
                "native_tool_completed",
                "call_cap_hit",
            ):
                rewards[name] = float(result[name])
            rewards["call_rejected"] = float(result["rejected_calls"] > 0)
            if not result["valid"]:
                rewards["reward"] = 0.0
        reward_path.write_text(json.dumps(rewards, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
