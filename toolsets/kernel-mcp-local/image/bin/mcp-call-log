#!/usr/bin/env python3
"""Proxy a stdio MCP server, logging calls and optionally restricting its tools.

With an allowlist, the server's own usage instructions are withheld too: they
rank its tools and name ones the arm lacks, and the task instruction already
says how to use the arm's tools.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import threading
import time
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

WEBMCP_IN_CODE = re.compile(r"\b(?:listTools|invokeTool)\s*\(")
WEBMCP = re.compile(r"webmcp", re.IGNORECASE)
# `webmcp` listed after the other names a description says are in scope.
WEBMCP_IN_SCOPE = re.compile(r"(`),\s*(?:and\s+)?(?:browser-wide\s+)?`webmcp`(?:\s+helpers)?")


def parse(line: bytes) -> dict[str, Any]:
    try:
        message = json.loads(line)
    except ValueError:
        return {}
    return message if isinstance(message, dict) else {}


def rejection(
    name: Any, arguments: dict[str, Any], allowed: set[str], session: str | None
) -> str | None:
    """Why the arm does not permit this call, or None when it may reach the server."""
    if name not in allowed:
        return "This arm does not provide that tool. Use only the listed browser tools."
    if not session or arguments.get("session_id") != session:
        return "Pass the session ID in /run/kernel-mcp/session-id as session_id."
    if name == "webmcp" and arguments.get("action") not in {"list", "invoke"}:
        return "This arm permits only the list and invoke actions of webmcp."
    if "webmcp" not in allowed and WEBMCP_IN_CODE.search(str(arguments.get("code") or "")):
        return "This arm does not permit WebMCP. Use Playwright DOM/UI actions instead."
    return None


def without_webmcp(text: str) -> str:
    """Cut each paragraph of a description at its first sentence that mentions WebMCP.

    The server follows a tool's own description with guidance to prefer WebMCP,
    and the sentences after it continue that guidance.
    """
    paragraphs = []
    for paragraph in WEBMCP_IN_SCOPE.sub(r"\1", text).split("\n\n"):
        kept = []
        for sentence in re.split(r"(?<=\.)\s+", paragraph):
            if WEBMCP.search(sentence):
                break
            kept.append(sentence)
        if kept:
            paragraphs.append(" ".join(kept))
    return "\n\n".join(paragraphs)


def describe_without_webmcp(tool: dict[str, Any]) -> None:
    properties = (tool.get("inputSchema") or {}).get("properties") or {}
    for described in (tool, *properties.values()):
        if isinstance(described, dict) and isinstance(described.get("description"), str):
            described["description"] = without_webmcp(described["description"])


def main() -> int:
    log_path, command = sys.argv[1], sys.argv[2:]
    allowed = set(filter(None, os.environ.get("KERNEL_BENCH_ALLOWED_TOOLS", "").split(",")))
    session_file = Path("/run/kernel-mcp/session-id")
    session = os.environ.get("KERNEL_SESSION_ID") or (
        session_file.read_text().strip() if session_file.exists() else None
    )
    lock = threading.Lock()
    output_lock = threading.Lock()
    pending: dict[Any, tuple[str, dict[str, Any], float, str]] = {}
    child = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    assert child.stdin is not None and child.stdout is not None

    with open(log_path, "a") as log:

        def record(
            params: dict[str, Any],
            started: float,
            started_at: str,
            result: dict[str, Any],
            rejected: bool = False,
        ) -> None:
            entry = {
                "tool": params.get("name"),
                "arguments": params.get("arguments"),
                "started_at": started_at,
                "duration_ms": round((time.monotonic() - started) * 1000),
                "is_error": "error" in result
                or (result.get("result") or {}).get("isError") is True,
                "rejected": rejected,
            }
            with lock:
                log.write(json.dumps(entry) + "\n")
                log.flush()

        def emit(line: bytes) -> None:
            with output_lock:
                sys.stdout.buffer.write(line)
                sys.stdout.buffer.flush()

        def to_server() -> None:
            for line in sys.stdin.buffer:
                message = parse(line)
                method = message.get("method")
                params = message.get("params") or {}
                started, started_at = time.monotonic(), datetime.now(UTC).isoformat()
                if method == "tools/call" and allowed:
                    arguments = params.get("arguments")
                    reason = rejection(
                        params.get("name"),
                        arguments if isinstance(arguments, dict) else {},
                        allowed,
                        session,
                    )
                    if reason:
                        response = {
                            "jsonrpc": "2.0",
                            "id": message.get("id"),
                            "result": {
                                "isError": True,
                                "content": [{"type": "text", "text": reason}],
                            },
                        }
                        record(params, started, started_at, response, rejected=True)
                        emit((json.dumps(response) + "\n").encode())
                        continue
                if "id" in message and method in {"tools/call", "tools/list", "initialize"}:
                    with lock:
                        pending[message["id"]] = (method, params, started, started_at)
                child.stdin.write(line)
                child.stdin.flush()
            child.stdin.close()

        threading.Thread(target=to_server, daemon=True).start()
        for line in child.stdout:
            message = parse(line)
            with lock:
                request = pending.pop(message.get("id"), None) if message else None
            if request:
                method, params, started, started_at = request
                if method == "tools/call":
                    record(params, started, started_at, message)
                elif allowed and "result" in message:
                    if method == "initialize":
                        message["result"].pop("instructions", None)
                    else:
                        tools = [
                            tool
                            for tool in message["result"].get("tools", [])
                            if tool.get("name") in allowed
                        ]
                        if "webmcp" not in allowed:
                            for tool in tools:
                                describe_without_webmcp(tool)
                        message["result"]["tools"] = tools
                    line = (json.dumps(message) + "\n").encode()
            emit(line)
    return child.wait()


if __name__ == "__main__":
    raise SystemExit(main())
