#!/bin/sh
# stdio MCP server for the agent: waits for the local Kernel MCP server and
# proxies to it with the project API key, logging each tool call for
# kernel-mcp-verify. Nothing may be written to stdout before mcp-remote
# starts, because stdout carries the MCP protocol.
set -eu

# mcp-remote expands ${KERNEL_MCP_AUTHORIZATION} itself, which keeps the key
# off its command line.
KERNEL_MCP_AUTHORIZATION="Bearer ${KERNEL_API_KEY:-$(cat /run/kernel-mcp/api-key)}"
export KERNEL_MCP_AUTHORIZATION
for _ in $(seq 1 120); do
  if curl -s -o /dev/null http://127.0.0.1:3002/; then
    exec mcp-call-log /var/log/kernel-mcp/calls.jsonl \
      mcp-remote http://127.0.0.1:3002/mcp \
      --header 'Authorization:${KERNEL_MCP_AUTHORIZATION}'
  fi
  sleep 1
done
echo "Kernel MCP server did not become ready" >&2
tail -50 /var/log/kernel-mcp/server.log >&2 || true
exit 1
